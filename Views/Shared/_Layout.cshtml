<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - QuickQR</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: 0.4s ease-in-out;
        }

        /* Light & Dark Mode Variables */
        :root {
            --bg: #f4f6ff;
            --card: #ffffff;
            --text: #222;
            --nav: linear-gradient(90deg, #4f46e5, #6d28d9);
        }

        [data-theme="dark"] {
            --bg: #0f0f17;
            --card: #181824;
            --text: #e2e2ff;
            --nav: linear-gradient(90deg, #2d2b87, #4b1c96);
        }

        /* Navbar */
        .navbar {
            background: var(--nav);
            padding: 12px 0;
            box-shadow: 0 2px 15px rgba(0,0,0,0.3);
        }

        .nav-link, .navbar-brand {
            color: #fff !important;
        }

        /* Floating Generate Button */
        .floating-btn {
            position: fixed;
            bottom: 28px;
            right: 28px;
            background: #6d28d9;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 28px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            cursor: pointer;
            transition: 0.3s;
            z-index: 999;
        }

            .floating-btn:hover {
                transform: scale(1.15);
                background: #5520b5;
            }

        /* Toggle Switch */
        .toggle-container {
            cursor: pointer;
            margin-left: 20px;
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" href="/">QuickQR</a>

            <button class="navbar-toggler text-white"
                    type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/QRCode/Index">Generate QR</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/QRCode/History">History</a>
                    </li>

                    @* <li class="nav-item d-flex align-items-center"> *@
                    @*     <span class="toggle-container" id="themeToggle"> *@
                    @*         <i class="bi bi-moon-stars-fill text-white fs-4"></i> *@
                    @*     </span> *@
                    @* </li> *@

                </ul>
            </div>

        </div>
    </nav>


    <!-- CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>


    <!-- Floating Button -->
    <a href="/QRCode/Index" class="floating-btn">
        <i class="bi bi-qr-code"></i>
    </a>


    <!-- FOOTER -->
    <footer class="text-center p-4 mt-5" style="background: var(--nav); color: white;">
        <p class="m-0">© 2025 QuickQR • Designed by <b>Nabila</b></p>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DARK MODE SCRIPT -->
    <script>
        const htmlTag = document.documentElement;
        const toggleBtn = document.getElementById("themeToggle");

        toggleBtn.addEventListener("click", () => {
            let current = htmlTag.getAttribute("data-theme");

            if (current === "light") {
                htmlTag.setAttribute("data-theme", "dark");
                toggleBtn.innerHTML = '<i class="bi bi-brightness-high-fill text-warning fs-4"></i>';
            } else {
                htmlTag.setAttribute("data-theme", "light");
                toggleBtn.innerHTML = '<i class="bi bi-moon-stars-fill text-white fs-4"></i>';
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>

</html>
